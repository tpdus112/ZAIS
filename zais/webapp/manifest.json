{
  "_version": "1.86.0",
  "sap.app": {
    "id": "zais.scm.zais",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.30.0",
      "toolsId": "10ebbad5-3737-4c00-a731-48f51c09f550"
    },
    "dataSources": {
      "ZAIS_LOGIN_SRV": {
        "uri": "/sap/opu/odata/sap/ZAIS_LOGIN_SRV/",
        "type": "OData",
        "settings": {
          "odataVersion": "2.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "config": {
      "fullWidth": true
    },
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.151.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "": {
        "dataSource": "ZAIS_LOGIN_SRV",
        "preload": true,
        "settings": {
          "defaultBindingMode": "TwoWay"
        }
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "zais.scm.zais.i18n.i18n"
        }
      },
      "loginService": {
        "dataSource": "ZAIS_LOGIN_SRV",
        "preload": true,
        "settings": {
          "useBatch": false
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        },
        {
          "uri": "css/login.css"
        },
        {
          "uri": "css/signup.css"
        },
        {
          "uri": "css/main/main.css"
        },
        {
          "uri": "css/main/mainHeader.css"
        },
        {
          "uri": "css/main/mainProcess.css"
        },
        {
          "uri": "css/main/mainMM.css"
        },
        {
          "uri": "css/main/mainPP.css"
        },
        {
          "uri": "css/main/mainSD.css"
        },
        {
          "uri": "css/modal/modal.css"
        }
      ]
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "zais.scm.zais.view",
        "async": true,
        "viewPath": "zais.scm.zais.view"
      },
      "routes": [
        {
          "name": "RouteLogin",
          "pattern": "",
          "target": ["TargetLogin"]
        },
        {
          "name": "RouteMain",
          "pattern": "main",
          "target": ["TargetMain"]
        },
        {
          "name": "RouteSignup",
          "pattern": "signup",
          "target": ["TargetSignup"]
        }
      ],
      "targets": {
        "TargetMain": {
          "id": "Main",
          "name": "main.Main"
        },
        "TargetLogin": {
          "id": "Login",
          "name": "Login"
        },
        "TargetSignup": {
          "id": "Signup",
          "name": "Signup"
        }
      }
    },
    "rootView": {
      "viewName": "zais.scm.zais.view.App",
      "type": "XML",
      "id": "App",
      "async": true
    }
  }
}
