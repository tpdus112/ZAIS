<mvc:View
    controllerName="zais.scm.zais.controller.main.MainSD"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox class="moduleProcessCard sdProcessCard" width="100%">
        <!-- 모듈 헤더 바 -->
        <HBox alignItems="Center" justifyContent="Center" class="moduleHeaderBar sdHeaderBar">
            <core:Icon src="sap-icon://shipping-status" class="moduleIcon sdIcon" />
            <Text text="SD 판매/출하" class="moduleTitle sdTitleText" />
        </HBox>

        <!-- 프로세스 단계 플로우 -->
        <HBox alignItems="Center" justifyContent="SpaceAround" class="flowStepsContainer">
            <VBox id="stepSO" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle sdStepCircle stepDone">
                    <core:Icon src="sap-icon://sales-order" class="stepIconDone" />
                </VBox>
                <Text text="Sales Order" class="stepName" />
                <Text text="10 / 10" class="stepCount" />
                <VBox class="stepStatusDot dotPurple" />
            </VBox>

            <core:Icon src="sap-icon://slim-arrow-right" class="stepArrow" />

            <VBox id="stepDelivery" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle sdStepCircle stepActive">
                    <core:Icon src="sap-icon://shipping-status" class="stepIconActive" />
                </VBox>
                <Text text="Delivery" class="stepName" />
                <Text text="5 / 10" class="stepCount" />
                <VBox class="stepStatusRing ringPurple" />
            </VBox>

            <core:Icon src="sap-icon://slim-arrow-right" class="stepArrow" />

            <VBox id="stepPGI" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle sdStepCircle stepActive">
                    <core:Icon src="sap-icon://receipt" class="stepIconActive" />
                </VBox>
                <Text text="PGI" class="stepName" />
                <Text text="4 / 10" class="stepCount" />
                <VBox class="stepStatusRing ringPurple" />
            </VBox>

            <core:Icon src="sap-icon://slim-arrow-right" class="stepArrow" />

            <VBox id="stepDeliveryComplete" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle sdStepCircle stepWaiting">
                    <core:Icon src="sap-icon://collaborate" class="stepIconWaiting" />
                </VBox>
                <Text text="납품 완료" class="stepName" />
                <Text text="0 / 10" class="stepCount" />
                <VBox class="stepStatusRing ringGray" />
            </VBox>
        </HBox>

        <!-- 하단 상세 테이블 (모든 열 가운데 정렬) -->
        <Table
            items="{dashboard>/process/sd/materials}"
            class="processMiniTable"
            inset="false"
            showNoData="false">
            <columns>
                <Column width="28%" hAlign="Center"><Text text="항목" class="tableColHeader" /></Column>
                <Column width="20%" hAlign="Center"><Text text="주문 수량" class="tableColHeader" /></Column>
                <Column width="20%" hAlign="Center"><Text text="완료 수량" class="tableColHeader" /></Column>
                <Column width="16%" hAlign="Center"><Text text="진행률" class="tableColHeader" /></Column>
                <Column width="16%" hAlign="Center"><Text text="상태" class="tableColHeader" /></Column>
            </columns>
            <items>
                <ColumnListItem class="tableRowItem">
                    <cells>
                        <Text text="{dashboard>name}" class="cellTextPrimary" />
                        <Text text="{dashboard>orderQty}" class="cellTextMuted" />
                        <Text text="{dashboard>doneQty}" class="cellTextMuted" />
                        <Text text="{dashboard>rate}" class="cellTextBold" />
                        <ObjectStatus
                            text="{dashboard>status}"
                            state="{dashboard>statusState}"
                            class="statusBadge" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>

</mvc:View>
