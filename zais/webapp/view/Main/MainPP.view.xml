<mvc:View
    controllerName="zais.scm.zais.controller.main.MainPP"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox class="moduleProcessCard ppProcessCard" width="100%">
        <!-- 모듈 헤더 바 -->
        <HBox alignItems="Center" justifyContent="Center" class="moduleHeaderBar ppHeaderBar">
            <core:Icon src="sap-icon://factory" class="moduleIcon ppIcon" />
            <Text text="PP 생산" class="moduleTitle ppTitleText" />
        </HBox>

        <!-- 프로세스 단계 플로우 -->
        <HBox alignItems="Center" justifyContent="SpaceAround" class="flowStepsContainer">
            <VBox id="stepDram" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle ppStepCircle stepDone">
                    <core:Icon src="sap-icon://developer-settings" class="stepIconDone" />
                </VBox>
                <Text text="DRAM 생산" class="stepName" />
                <Text text="12,000 EA" class="stepCount" />
                <Text text="100%" class="stepRateText" />
            </VBox>

            <core:Icon src="sap-icon://slim-arrow-right" class="stepArrow" />

            <VBox id="stepHBM" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle ppStepCircle stepActive">
                    <core:Icon src="sap-icon://database" class="stepIconActive" />
                </VBox>
                <Text text="HBM3E 생산" class="stepName" />
                <Text text="640 EA" class="stepCount" />
                <Text text="60%" class="stepRateText" />
            </VBox>

            <core:Icon src="sap-icon://slim-arrow-right" class="stepArrow" />

            <VBox id="stepBGP" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle ppStepCircle stepActive">
                    <core:Icon src="sap-icon://grid" class="stepIconActive" />
                </VBox>
                <Text text="BGP 생산" class="stepName" />
                <Text text="80 EA" class="stepCount" />
                <Text text="31%" class="stepRateText" />
            </VBox>

            <core:Icon src="sap-icon://slim-arrow-right" class="stepArrow" />

            <VBox id="stepGPU" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle ppStepCircle stepWaiting">
                    <core:Icon src="sap-icon://it-instance" class="stepIconWaiting" />
                </VBox>
                <Text text="GPU 생산" class="stepName" />
                <Text text="10 EA" class="stepCount" />
                <Text text="0%" class="stepRateText" />
            </VBox>

            <core:Icon src="sap-icon://slim-arrow-right" class="stepArrow" />

            <VBox id="stepAIS" alignItems="Center" class="stepItem">
                <VBox alignItems="Center" justifyContent="Center" class="stepCircle ppStepCircle stepActive">
                    <core:HTML content="&lt;svg class='brainSvgIcon' width='18' height='18' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.2' stroke-linecap='round' stroke-linejoin='round'&gt;&lt;path d='M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-2.04Z'/&gt;&lt;path d='M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-2.04Z'/&gt;&lt;/svg&gt;" />
                </VBox>
                <Text text="AIS 조립" class="stepName" />
                <Text text="10 EA" class="stepCount" />
                <VBox class="stepStatusRing ringGreen" />
            </VBox>
        </HBox>

        <!-- 하단 상세 테이블 (모든 열 가운데 정렬) -->
        <Table
            items="{dashboard>/process/pp/materials}"
            class="processMiniTable"
            inset="false"
            showNoData="false">
            <columns>
                <Column width="30%" hAlign="Center"><Text text="공정/품목" class="tableColHeader" /></Column>
                <Column width="18%" hAlign="Center"><Text text="계획 수량" class="tableColHeader" /></Column>
                <Column width="18%" hAlign="Center"><Text text="생산 실적" class="tableColHeader" /></Column>
                <Column width="18%" hAlign="Center"><Text text="진행률" class="tableColHeader" /></Column>
                <Column width="16%" hAlign="Center"><Text text="상태" class="tableColHeader" /></Column>
            </columns>
            <items>
                <ColumnListItem class="tableRowItem">
                    <cells>
                        <Text text="{dashboard>name}" class="cellTextPrimary" />
                        <Text text="{dashboard>planQty}" class="cellTextMuted" />
                        <Text text="{dashboard>actQty}" class="cellTextMuted" />
                        <Text text="{dashboard>rate}" class="cellTextBold" />
                        <ObjectStatus
                            text="{dashboard>status}"
                            state="{dashboard>statusState}"
                            class="statusBadge" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>
    </VBox>

</mvc:View>
