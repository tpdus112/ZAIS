<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="materialDialog"
        title="자재 재고 충족 현황"
        icon="sap-icon://product"
        contentWidth="950px"
        class="sapUiResponsiveContentPadding materialModalDialog">

        <content>

            <VBox width="100%">

                <!-- 설명 -->
                <Text
                    text="잔여 AIS 판매 수량 생산에 필요한 BOM 자재와 현재 재고를 비교한 결과입니다."
                    class="sapUiSmallMarginBottom" />

                <!-- 자재 테이블 -->
                <Table
                    id="modalMaterialTable"
                    items="{dashboard>/materials}"
                    class="processMiniTable modalTable"
                    inset="false"
                    showNoData="true"
                    noDataText="조회된 자재가 없습니다.">

                    <columns>

                        <Column
                            width="16%"
                            hAlign="Center">
                            <Text
                                text="자재 코드"
                                class="tableColHeader" />
                        </Column>

                        <Column
                            width="28%"
                            hAlign="Begin">
                            <Text
                                text="자재명"
                                class="tableColHeader" />
                        </Column>

                        <Column
                            width="7%"
                            hAlign="Center">
                            <Text
                                text="단위"
                                class="tableColHeader" />
                        </Column>

                        <Column
                            width="13%"
                            hAlign="End">
                            <Text
                                text="필요 수량"
                                class="tableColHeader" />
                        </Column>

                        <Column
                            width="13%"
                            hAlign="End">
                            <Text
                                text="현재 재고"
                                class="tableColHeader" />
                        </Column>

                        <Column
                            width="13%"
                            hAlign="End">
                            <Text
                                text="부족 수량"
                                class="tableColHeader" />
                        </Column>

                        <Column
                            width="10%"
                            hAlign="Center">
                            <Text
                                text="상태"
                                class="tableColHeader" />
                        </Column>

                    </columns>

                    <items>

                        <ColumnListItem
                            class="tableRowItem"
                            vAlign="Middle">

                            <cells>

                                <Text
                                    text="{dashboard>code}"
                                    class="cellTextBold" />

                                <Text
                                    text="{dashboard>name}"
                                    class="cellTextPrimary" />

                                <Text
                                    text="{dashboard>unit}"
                                    class="cellTextMuted" />

                                <ObjectNumber
                                    number="{dashboard>requiredQtyText}"
                                    unit="{dashboard>unit}" />

                                <ObjectNumber
                                    number="{dashboard>stockQtyText}"
                                    unit="{dashboard>unit}" />

                                <ObjectNumber
                                    number="{dashboard>shortageQtyText}"
                                    unit="{dashboard>unit}"
                                    state="{
                                        = ${dashboard>shortageQty} > 0
                                        ? 'Error'
                                        : 'None'
                                    }" />

                                <ObjectStatus
                                    text="{dashboard>status}"
                                    state="{dashboard>statusState}"
                                    class="statusBadge" />

                            </cells>

                        </ColumnListItem>

                    </items>

                </Table>

            </VBox>

        </content>

        <endButton>
            <Button
                text="닫기"
                type="Emphasized"
                press=".onCloseMaterialDialog" />
        </endButton>

    </Dialog>

</core:FragmentDefinition>