<mvc:View
    controllerName="zais.scm.zais.controller.modal.SD.DeliveryComplete"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox width="100%">

        <!-- =====================================================
             1. 상단 검색 필터
             ===================================================== -->
        <HBox
            alignItems="Center"
            justifyContent="SpaceBetween"
            class="modalFilterBar">

            <HBox alignItems="Center">

                <!-- 통합 검색 -->
                <Input
                    id="searchKeyword"
                    placeholder="청구문서 / Delivery / SO번호 / 고객사 / 자재명"
                    width="300px"
                    class="filterFieldItem filterInput" />

                <!-- 상태 -->
                <Select
                    id="searchStatus"
                    selectedKey="ALL"
                    width="125px"
                    class="filterFieldItem filterSelect">

                    <items>

                        <core:Item
                            key="ALL"
                            text="상태 전체" />

                        <core:Item
                            key="COMPLETED"
                            text="납품 완료" />

                    </items>

                </Select>

                <!-- 청구일 From -->
                <DatePicker
                    id="searchDateFrom"
                    placeholder="청구일 (From)"
                    displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd"
                    width="140px"
                    class="filterDatePicker" />

                <Text
                    text="~"
                    class="filterTildeText" />

                <!-- 청구일 To -->
                <DatePicker
                    id="searchDateTo"
                    placeholder="청구일 (To)"
                    displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd"
                    width="140px"
                    class="filterFieldItem filterDatePicker" />

                <Button
                    text="검색"
                    type="Emphasized"
                    class="filterSearchBtn"
                    press=".onSearch" />

                <Button
                    text="초기화"
                    type="Transparent"
                    class="filterResetBtn"
                    press=".onReset" />

            </HBox>

        </HBox>


        <!-- =====================================================
             2. 납품 완료 목록
             ===================================================== -->
        <Table
            id="deliveryCompleteTable"
            items="{pagination>/displayList}"
            class="modalDetailTable"
            inset="false"
            showNoData="true"
            noDataText="조회된 납품 완료 내역이 없습니다.">

            <columns>

                <!-- Billing Document -->
                <Column
                    width="11%"
                    hAlign="Center">

                    <Text
                        text="청구문서"
                        class="tableColHeader" />

                </Column>

                <!-- 품목 -->
                <Column
                    width="6%"
                    hAlign="Center">

                    <Text
                        text="품목"
                        class="tableColHeader" />

                </Column>

                <!-- Sales Order -->
                <Column
                    width="11%"
                    hAlign="Center">

                    <Text
                        text="Sales Order"
                        class="tableColHeader" />

                </Column>

                <!-- Delivery -->
                <Column
                    width="11%"
                    hAlign="Center">

                    <Text
                        text="Delivery"
                        class="tableColHeader" />

                </Column>

                <!-- 고객사 -->
                <Column
                    width="13%"
                    hAlign="Center">

                    <Text
                        text="고객사"
                        class="tableColHeader" />

                </Column>

                <!-- 자재코드 -->
                <Column
                    width="11%"
                    hAlign="Center">

                    <Text
                        text="자재코드"
                        class="tableColHeader" />

                </Column>

                <!-- 자재명 -->
                <Column
                    width="17%"
                    hAlign="Center">

                    <Text
                        text="자재명"
                        class="tableColHeader" />

                </Column>

                <!-- Billing 수량 -->
                <Column
                    width="8%"
                    hAlign="Center">

                    <Text
                        text="수량"
                        class="tableColHeader" />

                </Column>

                <!-- Billing Date -->
                <Column
                    width="10%"
                    hAlign="Center">

                    <Text
                        text="청구일자"
                        class="tableColHeader" />

                </Column>

                <!-- 상태 -->
                <Column
                    width="9%"
                    hAlign="Center">

                    <Text
                        text="상태"
                        class="tableColHeader" />

                </Column>

            </columns>


            <items>

                <ColumnListItem class="tableRowItem">

                    <cells>

                        <!-- 청구문서 -->
                        <Text
                            text="{pagination>billNo}"
                            class="modalCellTextBold" />

                        <!-- 품목 -->
                        <Text
                            text="{pagination>itemNo}"
                            class="modalCellText" />

                        <!-- Sales Order -->
                        <Text
                            text="{pagination>soNo}"
                            class="modalCellTextBold" />

                        <!-- Delivery -->
                        <Text
                            text="{pagination>deliveryNo}"
                            class="modalCellText" />

                        <!-- 고객사 -->
                        <Text
                            text="{pagination>customer}"
                            class="modalCellText" />

                        <!-- 자재코드 -->
                        <Text
                            text="{pagination>matCode}"
                            class="modalCellTextBold" />

                        <!-- 자재명 -->
                        <Text
                            text="{pagination>matName}"
                            class="modalCellText" />

                        <!-- 수량 -->
                        <Text
                            text="{= ${pagination>billQty} + ' ' + ${pagination>unit} }"
                            class="modalCellText" />

                        <!-- 청구일자 -->
                        <Text
                            text="{pagination>billDate}"
                            class="modalCellText" />

                        <!-- 상태 -->
                        <ObjectStatus
                            text="{pagination>status}"
                            state="{pagination>statusState}"
                            class="statusBadge" />

                    </cells>

                </ColumnListItem>

            </items>

        </Table>


        <!-- =====================================================
             3. 페이지네이션
             ===================================================== -->
        <HBox
            alignItems="Center"
            justifyContent="End"
            class="modalPaginationBar">

            <Text
                text="{= '전체 ' + (${pagination>/totalCount} || 0) + ' 건' }"
                class="paginationTotalText sapUiSmallMarginEnd" />

            <Button
                icon="sap-icon://media-rewind"
                type="Transparent"
                class="paginationBtn"
                tooltip="첫 페이지"
                press=".onPaginationFirst" />

            <Button
                icon="sap-icon://navigation-left-arrow"
                type="Transparent"
                class="paginationBtn"
                tooltip="이전 페이지"
                press=".onPaginationPrev" />

            <Text
                text="{= (${pagination>/currentPage} || 1) + '  /  ' + (${pagination>/totalPages} || 1) }"
                class="paginationPageText" />

            <Button
                icon="sap-icon://navigation-right-arrow"
                type="Transparent"
                class="paginationBtn"
                tooltip="다음 페이지"
                press=".onPaginationNext" />

            <Button
                icon="sap-icon://media-forward"
                type="Transparent"
                class="paginationBtn"
                tooltip="마지막 페이지"
                press=".onPaginationLast" />

        </HBox>

    </VBox>

</mvc:View>