<mvc:View
    controllerName="zais.scm.zais.controller.modal.SD.SO"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox width="100%">

        <!-- =====================================================
             1. 검색 필터
             ===================================================== -->
        <HBox
            alignItems="Center"
            justifyContent="SpaceBetween"
            class="modalFilterBar">

            <HBox alignItems="Center">

                <Input
                    id="searchKeyword"
                    placeholder="오더 번호 / 고객사 / 자재명"
                    width="280px"
                    class="filterFieldItem filterInput" />

                <Select
                    id="searchStatus"
                    selectedKey="ALL"
                    width="115px"
                    class="filterFieldItem filterSelect">

                    <items>

                        <core:Item
                            key="ALL"
                            text="상태 전체" />

                        <core:Item
                            key="COMPLETED"
                            text="수주 완료" />

                    </items>

                </Select>

                <DatePicker
                    id="searchDateFrom"
                    placeholder="수주일 (From)"
                    displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd"
                    width="140px"
                    class="filterDatePicker" />

                <Text
                    text="~"
                    class="filterTildeText" />

                <DatePicker
                    id="searchDateTo"
                    placeholder="수주일 (To)"
                    displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd"
                    width="140px"
                    class="filterFieldItem filterDatePicker" />

                <Button
                    text="검색"
                    type="Emphasized"
                    class="filterSearchBtn"
                    press=".onSearch" />

                <Button
                    text="초기화"
                    type="Transparent"
                    class="filterResetBtn"
                    press=".onReset" />

            </HBox>

        </HBox>


        <!-- =====================================================
             2. Sales Order 목록
             ===================================================== -->
        <Table
            id="soTable"
            items="{pagination>/displayList}"
            class="modalDetailTable"
            inset="false"
            showNoData="true"
            noDataText="조회된 Sales Order 내역이 없습니다.">

            <columns>

                <Column
                    width="13%"
                    hAlign="Center">

                    <Text
                        text="오더 번호"
                        class="tableColHeader" />

                </Column>


                <Column
                    width="7%"
                    hAlign="Center">

                    <Text
                        text="품목"
                        class="tableColHeader" />

                </Column>


                <Column
                    width="15%"
                    hAlign="Center">

                    <Text
                        text="고객사"
                        class="tableColHeader" />

                </Column>


                <Column
                    width="13%"
                    hAlign="Center">

                    <Text
                        text="자재코드"
                        class="tableColHeader" />

                </Column>


                <Column
                    width="20%"
                    hAlign="Center">

                    <Text
                        text="자재명"
                        class="tableColHeader" />

                </Column>


                <Column
                    width="10%"
                    hAlign="Center">

                    <Text
                        text="주문수량"
                        class="tableColHeader" />

                </Column>


                <Column
                    width="12%"
                    hAlign="Center">

                    <Text
                        text="수주일"
                        class="tableColHeader" />

                </Column>


                <Column
                    width="10%"
                    hAlign="Center">

                    <Text
                        text="상태"
                        class="tableColHeader" />

                </Column>

            </columns>


            <items>

                <ColumnListItem
                    class="tableRowItem">

                    <cells>

                        <!-- Sales Order -->
                        <Text
                            text="{pagination>soNo}"
                            class="modalCellTextBold" />


                        <!-- 품목 -->
                        <Text
                            text="{pagination>itemNo}"
                            class="modalCellText" />


                        <!-- 고객 -->
                        <Text
                            text="{pagination>customer}"
                            class="modalCellText" />


                        <!-- 자재코드 -->
                        <Text
                            text="{pagination>matCode}"
                            class="modalCellTextBold" />


                        <!-- 자재명 -->
                        <Text
                            text="{pagination>matName}"
                            class="modalCellText" />


                        <!-- 주문수량 -->
                        <Text
                            text="{= ${pagination>orderQty} + ' ' + ${pagination>unit} }"
                            class="modalCellText" />


                        <!-- 수주일 -->
                        <Text
                            text="{pagination>orderDate}"
                            class="modalCellText" />


                        <!-- 상태 -->
                        <ObjectStatus
                            text="{pagination>status}"
                            state="{pagination>statusState}"
                            class="statusBadge" />

                    </cells>

                </ColumnListItem>

            </items>

        </Table>


        <!-- =====================================================
             3. 페이지네이션
             ===================================================== -->
        <HBox
            alignItems="Center"
            justifyContent="End"
            class="modalPaginationBar">

            <Text
                text="{= '전체 ' + (${pagination>/totalCount} || 0) + ' 건' }"
                class="paginationTotalText sapUiSmallMarginEnd" />

            <Button
                icon="sap-icon://media-rewind"
                type="Transparent"
                class="paginationBtn"
                tooltip="첫 페이지"
                press=".onPaginationFirst" />

            <Button
                icon="sap-icon://navigation-left-arrow"
                type="Transparent"
                class="paginationBtn"
                tooltip="이전 페이지"
                press=".onPaginationPrev" />

            <Text
                text="{= (${pagination>/currentPage} || 1) + '  /  ' + (${pagination>/totalPages} || 1) }"
                class="paginationPageText" />

            <Button
                icon="sap-icon://navigation-right-arrow"
                type="Transparent"
                class="paginationBtn"
                tooltip="다음 페이지"
                press=".onPaginationNext" />

            <Button
                icon="sap-icon://media-forward"
                type="Transparent"
                class="paginationBtn"
                tooltip="마지막 페이지"
                press=".onPaginationLast" />

        </HBox>

    </VBox>

</mvc:View>