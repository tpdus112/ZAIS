<mvc:View
    controllerName="zais.scm.zais.controller.modal.PP.DramProd"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox width="100%">
        <!-- 1. 상단 검색 필터 바 -->
        <HBox
            alignItems="Center"
            justifyContent="SpaceBetween"
            class="modalFilterBar">

            <HBox alignItems="Center">
                <!-- 통합 검색 -->
                <Input
                    id="searchKeyword"
                    placeholder="자재코드 / 자재명 / 생산라인"
                    width="280px"
                    class="filterFieldItem filterInput" />

                <!-- 상태 Select -->
                <Select
                    id="searchStatus"
                    selectedKey="ALL"
                    width="115px"
                    class="filterFieldItem filterSelect">
                    <items>
                        <core:Item key="ALL" text="상태 전체" />
                        <core:Item key="COMPLETED" text="완료" />
                        <core:Item key="IN_PROGRESS" text="진행 중" />
                        <core:Item key="WAITING" text="대기" />
                    </items>
                </Select>

                <!-- 기간 From -->
                <DatePicker
                    id="searchDateFrom"
                    placeholder="기간 (From)"
                    displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd"
                    width="140px"
                    class="filterDatePicker" />

                <Text text="~" class="filterTildeText" />

                <!-- 기간 To -->
                <DatePicker
                    id="searchDateTo"
                    placeholder="기간 (To)"
                    displayFormat="yyyy-MM-dd"
                    valueFormat="yyyy-MM-dd"
                    width="140px"
                    class="filterFieldItem filterDatePicker" />

                <Button
                    text="검색"
                    type="Emphasized"
                    class="filterSearchBtn"
                    press=".onSearch" />

                <Button
                    text="초기화"
                    type="Transparent"
                    class="filterResetBtn"
                    press=".onReset" />
            </HBox>
        </HBox>

        <!-- 2. DRAM 반복생산 현황 목록 테이블 -->
        <Table
            id="dramProdTable"
            items="{pagination>/displayList}"
            class="modalDetailTable"
            inset="false"
            showNoData="true"
            noDataText="조회된 DRAM 반복생산 내역이 없습니다.">

            <columns>
                <Column width="18%" hAlign="Center">
                    <Text text="주차 / 기간" class="tableColHeader" />
                </Column>
                <Column width="13%" hAlign="Center">
                    <Text text="생산라인" class="tableColHeader" />
                </Column>
                <Column width="7%" hAlign="Center">
                    <Text text="플랜트" class="tableColHeader" />
                </Column>
                <Column width="12%" hAlign="Center">
                    <Text text="자재코드" class="tableColHeader" />
                </Column>
                <Column width="12%" hAlign="Center">
                    <Text text="자재명" class="tableColHeader" />
                </Column>
                <Column width="11%" hAlign="Center">
                    <Text text="계획수량" class="tableColHeader" />
                </Column>
                <Column width="11%" hAlign="Center">
                    <Text text="생산실적" class="tableColHeader" />
                </Column>
                <Column width="8%" hAlign="Center">
                    <Text text="진행률" class="tableColHeader" />
                </Column>
                <Column width="8%" hAlign="Center">
                    <Text text="상태" class="tableColHeader" />
                </Column>
            </columns>

            <items>
                <ColumnListItem class="tableRowItem">
                    <cells>
                        <!-- 주차 / 기간 -->
                        <Text text="{pagination>weekPeriod}" class="modalCellTextBold" />

                        <!-- 생산라인 -->
                        <Text text="{pagination>prodLine}" class="modalCellText" />

                        <!-- 플랜트 -->
                        <Text text="{pagination>plant}" class="modalCellText" />

                        <!-- 자재코드 -->
                        <Text text="{pagination>matCode}" class="modalCellTextBold" />

                        <!-- 자재명 -->
                        <Text text="{pagination>matName}" class="modalCellText" />

                        <!-- 계획수량 -->
                        <Text
                            text="{= ${pagination>planQty} + ' ' + ${pagination>unit} }"
                            class="modalCellText" />

                        <!-- 생산실적 -->
                        <Text
                            text="{= ${pagination>actQty} + ' ' + ${pagination>unit} }"
                            class="modalCellText" />

                        <!-- 진행률 -->
                        <Text text="{pagination>rate}" class="modalCellTextBold" />

                        <!-- 상태 -->
                        <ObjectStatus
                            text="{pagination>status}"
                            state="{pagination>statusState}"
                            class="statusBadge" />
                    </cells>
                </ColumnListItem>
            </items>
        </Table>

        <!-- 3. 페이지네이션 바 -->
        <HBox
            alignItems="Center"
            justifyContent="End"
            class="modalPaginationBar">

            <!-- 전체 건수 표시 -->
            <Text
                text="{= '전체 ' + (${pagination>/totalCount} !== undefined ? ${pagination>/totalCount} : ${dashboard>/currentModal/totalCount}) + ' 건' }"
                class="paginationTotalText sapUiSmallMarginEnd" />

            <Button
                icon="sap-icon://media-rewind"
                type="Transparent"
                class="paginationBtn"
                tooltip="첫 페이지"
                press=".onPaginationFirst" />

            <Button
                icon="sap-icon://navigation-left-arrow"
                type="Transparent"
                class="paginationBtn"
                tooltip="이전 페이지"
                press=".onPaginationPrev" />

            <Text
                text="{= (${pagination>/currentPage} || 1) + '  /  ' + (${pagination>/totalPages} || 1) }"
                class="paginationPageText" />

            <Button
                icon="sap-icon://navigation-right-arrow"
                type="Transparent"
                class="paginationBtn"
                tooltip="다음 페이지"
                press=".onPaginationNext" />

            <Button
                icon="sap-icon://media-forward"
                type="Transparent"
                class="paginationBtn"
                tooltip="마지막 페이지"
                press=".onPaginationLast" />
        </HBox>
    </VBox>

</mvc:View>
