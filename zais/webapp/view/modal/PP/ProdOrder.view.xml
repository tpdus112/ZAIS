<mvc:View
    controllerName="zais.scm.zais.controller.modal.PP.ProdOrder"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <VBox width="100%">

        <!-- 1. 검색 필터 -->
        <HBox
            alignItems="Center"
            justifyContent="SpaceBetween"
            class="modalFilterBar">

            <HBox alignItems="Center">

                <Input
                    id="searchKeyword"
                    placeholder="생산오더번호 / 자재코드 / 자재명"
                    width="280px"
                    class="filterFieldItem filterInput"
                    submit=".onSearch" />

                <Select
                    id="searchStatus"
                    selectedKey="ALL"
                    width="115px"
                    class="filterFieldItem filterSelect">

                    <items>
                        <core:Item key="ALL" text="상태 전체" />
                        <core:Item key="COMPLETED" text="완료" />
                        <core:Item key="IN_PROGRESS" text="진행 중" />
                        <core:Item key="WAITING" text="대기" />
                    </items>

                </Select>

                <Button
                    text="검색"
                    type="Emphasized"
                    class="filterSearchBtn"
                    press=".onSearch" />

                <Button
                    text="초기화"
                    type="Transparent"
                    class="filterResetBtn"
                    press=".onReset" />

            </HBox>

        </HBox>


        <!-- 2. 생산오더 목록 -->
        <Table
            id="prodOrderTable"
            items="{pagination>/displayList}"
            class="modalDetailTable"
            inset="false"
            showNoData="true"
            noDataText="조회된 생산오더 내역이 없습니다.">

            <columns>

                <Column width="15%" hAlign="Center">
                    <Text
                        text="생산오더번호"
                        class="tableColHeader" />
                </Column>

                <Column width="15%" hAlign="Center">
                    <Text
                        text="자재코드"
                        class="tableColHeader" />
                </Column>

                <Column width="20%" hAlign="Center">
                    <Text
                        text="자재명"
                        class="tableColHeader" />
                </Column>

                <Column width="12%" hAlign="Center">
                    <Text
                        text="계획수량"
                        class="tableColHeader" />
                </Column>

                <Column width="12%" hAlign="Center">
                    <Text
                        text="생산실적"
                        class="tableColHeader" />
                </Column>

                <Column width="12%" hAlign="Center">
                    <Text
                        text="진행률"
                        class="tableColHeader" />
                </Column>

                <Column width="14%" hAlign="Center">
                    <Text
                        text="상태"
                        class="tableColHeader" />
                </Column>

            </columns>


            <items>

                <ColumnListItem class="tableRowItem">

                    <cells>

                        <!-- 생산오더 번호 -->
                        <Text
                            text="{pagination>orderNo}"
                            class="modalCellTextBold" />

                        <!-- 자재 코드 -->
                        <Text
                            text="{pagination>matCode}"
                            class="modalCellTextBold" />

                        <!-- 자재명 -->
                        <Text
                            text="{pagination>matName}"
                            class="modalCellText" />

                        <!-- 계획수량 -->
                        <Text
                            text="{= ${pagination>planQty} + ' ' + ${pagination>unit} }"
                            class="modalCellText" />

                        <!-- 생산실적 -->
                        <Text
                            text="{= ${pagination>actQty} + ' ' + ${pagination>unit} }"
                            class="modalCellText" />

                        <!-- 진행률 -->
                        <Text
                            text="{pagination>rate}"
                            class="modalCellTextBold" />

                        <!-- 상태 -->
                        <ObjectStatus
                            text="{pagination>status}"
                            state="{pagination>statusState}"
                            class="statusBadge" />

                    </cells>

                </ColumnListItem>

            </items>

        </Table>


        <!-- 3. 페이지네이션 -->
        <HBox
            alignItems="Center"
            justifyContent="End"
            class="modalPaginationBar">

            <Text
                text="{= '전체 ' + (${pagination>/totalCount} || 0) + ' 건' }"
                class="paginationTotalText sapUiSmallMarginEnd" />

            <Button
                icon="sap-icon://media-rewind"
                type="Transparent"
                class="paginationBtn"
                tooltip="첫 페이지"
                press=".onPaginationFirst" />

            <Button
                icon="sap-icon://navigation-left-arrow"
                type="Transparent"
                class="paginationBtn"
                tooltip="이전 페이지"
                press=".onPaginationPrev" />

            <Text
                text="{= (${pagination>/currentPage} || 1) + '  /  ' + (${pagination>/totalPages} || 1) }"
                class="paginationPageText" />

            <Button
                icon="sap-icon://navigation-right-arrow"
                type="Transparent"
                class="paginationBtn"
                tooltip="다음 페이지"
                press=".onPaginationNext" />

            <Button
                icon="sap-icon://media-forward"
                type="Transparent"
                class="paginationBtn"
                tooltip="마지막 페이지"
                press=".onPaginationLast" />

        </HBox>

    </VBox>

</mvc:View>